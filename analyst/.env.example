# Astrid Analyst — environment secrets
# Copy to .env and fill in. Source before running, or use as systemd EnvironmentFile.
# NEVER commit the real .env (it's gitignored).

# NVIDIA NIM (LLM) — https://build.nvidia.com
NIM_API_KEY=
# Optional overrides:
# NIM_BASE=https://integrate.api.nvidia.com/v1
# NIM_MODEL=meta/llama-3.1-70b-instruct

# SigNoz API key (Settings → API Keys) — used for query_range calls
SIGNOZ_API_KEY=

# ClickHouse direct HTTP (bypasses SigNoz authz limits on service accounts)
# CLICKHOUSE_HTTP=http://172.18.0.6:8123
